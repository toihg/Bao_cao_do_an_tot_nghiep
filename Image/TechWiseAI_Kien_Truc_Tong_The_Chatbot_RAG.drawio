<mxfile host="app.diagrams.net" modified="2026-11-20T00:00:00.000Z" agent="ChatGPT" version="24.7.17" type="device" compressed="false"><diagram id="ragarchitecture" name="Kiến trúc tổng thể Chatbot RAG"><mxGraphModel dx="1800" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1120" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="KIẾN TRÚC TỔNG THỂ MODULE CHATBOT RAG – TECHWISEAI" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=29;fontStyle=1;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="95" y="35" width="1680" height="65" as="geometry" /></mxCell><mxCell id="user" value="Người dùng" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#222222;strokeWidth=2;fontSize=22;fontFamily=Arial;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="80" y="185" width="200" height="95" as="geometry" /></mxCell><mxCell id="fe" value="&lt;b&gt;Next.js Frontend&lt;/b&gt;&lt;br&gt;Nhập câu hỏi – Hiển thị streaming&lt;br&gt;Liên kết sản phẩm" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#222222;strokeWidth=2;fontSize=19;fontFamily=Arial;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="355" y="165" width="335" height="135" as="geometry" /></mxCell><mxCell id="be" value="&lt;b&gt;Spring Boot Backend&lt;/b&gt;&lt;br&gt;API chatbot – Kiểm soát truy cập&lt;br&gt;Chuyển tiếp luồng SSE" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#222222;strokeWidth=2;fontSize=19;fontFamily=Arial;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="775" y="165" width="345" height="135" as="geometry" /></mxCell><mxCell id="ai" value="&lt;b&gt;FastAPI RAG Service&lt;/b&gt;&lt;br&gt;Điều phối pipeline RAG&lt;br&gt;Phân tích – Truy xuất – Sinh đáp án" style=