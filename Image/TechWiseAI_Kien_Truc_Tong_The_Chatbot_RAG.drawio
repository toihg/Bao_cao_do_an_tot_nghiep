th="335" height="110" as="geometry" /></mxCell><mxCell id="search" value="&lt;b&gt;Hybrid Retrieval&lt;/b&gt;&lt;br&gt;Keyword + Semantic Search&lt;br&gt;Hợp nhất bằng RRF" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#222222;strokeWidth=2;fontSize=19;fontFamily=Arial;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="810" y="665" width="335" height="120" as="geometry" /></mxCell><mxCell id="db" value="&lt;b&gt;PostgreSQL + pgvector&lt;/b&gt;&lt;br&gt;products – rag_document&lt;br&gt;rag_embedding VECTOR(1024)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#ffffff;strokeColor=#222222;strokeWidth=2;fontSize=19;fontFamily=Arial;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="360" y="645" width="350" height="150" as="geometry" /></mxCell><mxCell id="llm" value="&lt;b&gt;LLM Generator&lt;/b&gt;&lt;br&gt;Gemini 3.1 Flash Lite&lt;br&gt;(hoặc Qwen3 local)&lt;br&gt;Sinh phản hồi streaming" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#222222;strokeWidth=2;fontSize=19;fontFamily=Arial;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="1250" y="665" width="350" height="150" as="geometry" /></mxCell><mxCell id="e4" value="Phân tích câu hỏi" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#333333;strokeWidth=2;endArrow=block;endFill=1;fontSize=15;fontFamily=Arial;labelBackgroundColor=#ffffff;exitX=0.65;exitY=1;entryX=0.6;entryY=0;" edge="1" parent="1" source="ai" target="analyzer"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e5" value="Truy vấn đã chuẩn hóa" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#333333;strokeWidth=2;endArrow=block;endFill=1;fontSize=15;fontFamily=Arial;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="analyzer" target="embed"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e6" value="Vector truy vấn" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#333333;strokeWidth=2;endArrow=block;endFill=1;fontSize=15;fontFamily=Arial;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="embed" target="search"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e7" value="Tìm Top K / lọc metadata" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#333333;strokeWidth=2;endArrow=block;endFill=1;fontSize=15;fontFamily=Arial;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="search" target="db"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e8" value="Sản phẩm phù hợp" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#333333;strokeWidth=2;endArrow=block;endFill=1;fontSize=15;fontFamily=Arial;labelBackgroundColor=#ffffff;dashed=1;dashPattern=6 5;exitX=1;exitY=0.8;entryX=0;entryY=0.8;" edge="1" parent="1" source="db" target="search"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e9" value="Ngữ cảnh + kết quả RRF" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#333333;strokeWidth=2;endArrow=block;endFill=1;fontSize=15;fontFamily=Arial;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="search" target="llm"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e10" value="Token / phản hồi" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#333333;strokeWidth=2;endArrow=block;endFill=1;fontSize=15;fontFamily=Arial;labelBackgroundColor=#ffffff;dashed=1;dashPattern=6 5;exitX=0.85;exitY=0;entryX=0.9;entryY=1;" edge="1" parent="1" source="llm" target="ai"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="note1" value="&lt;b&gt;Nguyên tắc phân lớp&lt;/b&gt;&lt;br&gt;• Next.js: giao diện và hiển thị kết quả&lt;br&gt;• Spring Boot: API nghiệp vụ, proxy streaming&lt;br&gt;• FastAPI: điều phối truy xuất và sinh câu trả lời&lt;br&gt;• pgvector: lưu và tìm kiếm vector sản phẩm" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#888888;strokeWidth=1;fontSize=17;fontFamily=Arial;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1"><mxGeometry x="80" y="410" width="570" height="180" as="geometry" /></mxCell><mxCell id="note2" value="&lt;b&gt;Luồng phản hồi:&lt;/b&gt; LLM → FastAPI → Spring Boot → Next.js → Người dùng&lt;br&gt;&lt;b&gt;Đầu ra:&lt;/b&gt; Câu trả lời tư vấn + thông tin / liên kết sản phẩm" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#888888;strokeWidth=1;fontSize=19;fontFamily=Arial;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1"><mxGeometry x="650" y="910" width="1050" height="95" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>